cordis.patch.local.yml

# Personal ops tooling (starts/stops local dsh web, uses local paths)
tools/

# Early loose drafts at repo root (superseded by src/*.ts) — keep locally,
# do not track
/*.ts — *.ts

# Stray '~' directory created by shell expansion accidents
~/

# Local desktop client checkout / other local-only dirs
desktop/

# DSH handoff self-test markers
.dsh-handoff-selftest-*

# Personal maintenance scripts (hardcode /Users/<you> paths; not part of package)
scripts/backup-before-write.sh
scripts/writeguard.py

# Superseded drafts / internal working notes (contain local paths)
README — 新增三层兜底章节.md
插件市场发布调研.md
pre-push-privacy-audit.md

