{
  "name": "dsh-agent-flow-viz",
  "version": "0.1.0",
  "description": "Real-time tool-call flow visualizer for DeepSeek Harness (dsh). Listens to tools/pre-execute and tools/post-execute and renders each call as a node on a local web canvas.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent",
    "visualization",
    "tool-call",
    "flow",
    "monitoring",
    "tracing"
  ],
  "scripts": {
    "build": "node scripts/build/build.mjs",
    "start:server": "node scripts/run-server.mjs",
    "prepare": "npm run build"
  },
  "files": [
    "lib",
    "public",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "express": "^4.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0"
  },
  "devDependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
