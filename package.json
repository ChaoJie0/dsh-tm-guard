{
  "name": "dsh-tm-guard",
  "version": "0.2.1",
  "description": "Time-Machine-backed autonomous agent permission gate for DeepSeek Harness (dsh). Safe defaults on install (protect cwd, deny network/system, block sensitive reads). Configure protectedPaths/extraAllowTools to unlock subagent/workflow/web — see README.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.1 <0.1.0 || >=0.1.2-0 <0.2.0-0 || >=0.2.0-0 <0.3.0-0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "time-machine",
    "macos",
    "sandbox",
    "permission-gate",
    "autonomous-agent",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChaoJie0/dsh-tm-guard.git"
  },
  "homepage": "https://github.com/ChaoJie0/dsh-tm-guard#readme",
  "bugs": {
    "url": "https://github.com/ChaoJie0/dsh-tm-guard/issues"
  },
  "scripts": {
    "build": "node scripts/build/build.mjs",
    "prepare": "npm run build"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.1.0 || >=0.1.2-0 <0.2.0-0 || >=0.2.0-0 <0.3.0-0"
  },
  "devDependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
